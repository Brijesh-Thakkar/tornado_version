{"numsheets":1,"currentid":"sheet1","currentname":"sheet1","sheetArr":{"sheet1":{"sheetstr":{"savestr":"version:1.5\u000acell:C1:t:Tic Tac Toe\\n  scripting demo:b:1:1:1:1:f:1:cf:1:colspan:5:rowspan:3\u000acell:D1:b:1:1:1:1\u000acell:E1:b:1:1:1:1\u000acell:F1:b:1:1:1:1\u000acell:G1:b:1:1:1:1\u000acell:C2:b:1:1:1:1\u000acell:D2:b:1:1:1:1\u000acell:E2:b:1:1:1:1\u000acell:F2:b:1:1:1:1\u000acell:G2:b:1:1:1:1\u000acell:C3:b:1:1:1:1\u000acell:D3:b:1:1:1:1\u000acell:E3:b:1:1:1:1\u000acell:F3:b:1:1:1:1\u000acell:G3:b:1:1:1:1\u000acell:B7:t:<button id='Reset' onclick='\\nSocialCalc.UserScriptData.GameState = {};\\nSocialCalc.UserScriptData.GameState[\"type\"] = \"easy\"\\nSocialCalc.UserScriptData.SetToGameState(\"pos.1.1\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.1.2\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.1.3\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.1\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.2\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.3\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.1\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.2\");\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.3\");\\nSocialCalc.UserScriptData.SetToGameType();\\n'>\\nStart Game\\n</button>\\n<!--script\\n\\nSocialCalc.UserScriptData.SetToGameType = function() {\\n}\\n\\nSocialCalc.UserScriptData.SetGameType = function(type) {\\n    SocialCalc.UserScriptData.GameState[\"type\"] = type\\n    SocialCalc.UserScriptData.SetToGameType();\\n}\\n\\nSocialCalc.UserScriptData.CheckWonGame = function(let) {\\n  for (var x=1; x<4; x++) {\\n     var pos1 = \"pos.\"+x+\".1\"\\n     var pos2 = \"pos.\"+x+\".2\"\\n     var pos3 = \"pos.\"+x+\".3\"\\n     if ((SocialCalc.UserScriptData.GameState[pos1] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos1] == let) &&\\n         (SocialCalc.UserScriptData.GameState[pos2] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos2] == let) &&\\n         (SocialCalc.UserScriptData.GameState[pos3] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos3] == let)) {\\n        return true;\\n     }\\n  }\\n  for (var x=1; x<4; x++) {\\n     var pos1 = \"pos.\"+\"1.\"+x\\n     var pos2 = \"pos.\"+\"2.\"+x\\n     var pos3 = \"pos.\"+\"3.\"+x\\n     if ((SocialCalc.UserScriptData.GameState[pos1] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos1] == let) &&\\n         (SocialCalc.UserScriptData.GameState[pos2] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos2] == let) &&\\n         (SocialCalc.UserScriptData.GameState[pos3] != null) &&\\n         (SocialCalc.UserScriptData.GameState[pos3] == let)) {\\n        return true;\\n     }\\n  }\\n  // check diagonals\\n  if ((SocialCalc.UserScriptData.GameState['pos.1.1'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.1.1'] == let) &&\\n         (SocialCalc.UserScriptData.GameState['pos.2.2'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.2.2'] == let) &&\\n         (SocialCalc.UserScriptData.GameState['pos.3.3'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.3.3'] == let)) {\\n        return true;\\n   }\\n  // check diagonals\\n  if ((SocialCalc.UserScriptData.GameState['pos.1.3'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.1.3'] == let) &&\\n         (SocialCalc.UserScriptData.GameState['pos.2.2'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.2.2'] == let) &&\\n         (SocialCalc.UserScriptData.GameState['pos.3.1'] != null) &&\\n         (SocialCalc.UserScriptData.GameState['pos.3.1'] == let)) {\\n        return true;\\n   }\\n   return false;\\n}\\n\\nSocialCalc.UserScriptData.Respond = function() {\\n  // first check if won !!\\n  if (SocialCalc.UserScriptData.CheckWonGame('X')) {\\n     alert(\"You Won\");\\n     return;\\n  }\\n\\n  // find empty squares\\n  var empty = []\\n  for (var x=1; x<4; x++) {\\n     for (var y=1; y<4; y++) {\\n       var pos = \"pos\"+\".\"+x+\".\"+y\\n       if (SocialCalc.UserScriptData.GameState[pos] == null) {\\n          empty.push(pos)\\n       }\\n     }\\n  }\\n  if (empty.length == 0) {\\n     alert(\"Draw Game\");\\n  } else {\\n     //alert(empty.length);\\n  }\\n\\n  var randomnumber=Math.floor(Math.random()*empty.length)\\n\\n  var setpos = empty[randomnumber];\\n\\n  SocialCalc.UserScriptData.GameState[setpos] = 'O';\\n\\n  SocialCalc.UserScriptData.SetToGameState(setpos);\\n\\n  if (SocialCalc.UserScriptData.CheckWonGame('O')) {\\n     alert(\"I Won\");\\n     return;\\n  }\\n\\n  \\n  \\n}\\n\\nSocialCalc.UserScriptData.GameButtonClicked = function(pos) {\\n   // mark that button, then respond\\n   if (SocialCalc.UserScriptData.GameState[pos] != null) {\\n       // do nothing\\n       alert('already clicked');\\n   } else {\\n       SocialCalc.UserScriptData.GameState[pos] = 'X';\\n       SocialCalc.UserScriptData.SetToGameState(pos);\\n       SocialCalc.UserScriptData.Respond();\\n   }\\n}\\nSocialCalc.UserScriptData.SetToGameState = function(pos) {\\n  if (SocialCalc.UserScriptData.GameState[pos] == null) {\\n     var elem = document.getElementById(pos);\\n     if (elem) {\\n       elem.innerHTML = '&nbsp;&nbsp;&nbsp;';\\n     }\\n  } else {\\n     var elem = document.getElementById(pos);\\n     if (elem) {\\n       elem.innerHTML = SocialCalc.UserScriptData.GameState[pos];\\n     }\\n  }\\n}\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:D7:tvf:1\u000acell:E7:tvf:1\u000acell:B10:t:<button id='pos.1.1' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.1.1\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:C10:t:<button id='pos.1.2' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.1.2\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:D10:t:<button id='pos.1.3' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState('pos.1.3');\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:B11:t:<button id='pos.2.1' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.1\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:C11:t:<button id='pos.2.2' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.2\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:D11:t:<button id='pos.2.3' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.2.3\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:B12:t:<button id='pos.3.1' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.1\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:C12:t:<button id='pos.3.2' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.2\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000acell:D12:t:<button id='pos.3.3' onclick='\\nSocialCalc.UserScriptData.GameButtonClicked(this.id);\\n'>\\n      \\n</button>\\n<!--script\\nSocialCalc.UserScriptData.SetToGameState(\"pos.3.3\");\\nscript-->:b:1:1:1:1:cf:1:tvf:1\u000asheet:c:7:r:12\u000aborder:1:1px solid rgb(0,0,0)\u000acellformat:1:center\u000afont:1:italic bold 16pt *\u000avalueformat:1:text-html\u000a"},"name":"sheet1"}}}