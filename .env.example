# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your_s3_bucket_name_here
PDF_S3_BUCKET=s3_bucket_for_pdfs

# Dropbox OAuth
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here

# Application Secrets
COOKIE_SECRET=generate_a_random_secret_here

# Public base URL returned inside pdfurl JSON responses.
# The Ionic app emails, shares, and stores this URL, so it must be reachable
# by the end-user's device.  Strip any trailing slash.
#
# Local development:
#   PUBLIC_BASE_URL=http://localhost:8080
#
# EC2 (direct, no reverse proxy):
#   PUBLIC_BASE_URL=http://<EC2_PUBLIC_IP>
#
# Production behind a reverse proxy / ALB:
#   PUBLIC_BASE_URL=https://aspiringapps.com/api
#
# If unset, the URL is built from the incoming request's Host header
# (preserving the previous behaviour — safe for single-instance setups
# where the server is directly reachable).
#PUBLIC_BASE_URL=http://localhost:8080
