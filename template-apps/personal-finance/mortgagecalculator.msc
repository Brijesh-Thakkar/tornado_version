{"numsheets":2,"currentid":"sheet1","currentname":"mortgage","sheetArr":{"sheet1":{"sheetstr":{"savestr":"version:1.5\ncell:B3:t:Mortgage Information:f:3:cf:1:colspan:2\ncell:E3:t:Monthly Payment Chart:f:2:cf:1:colspan:4\ncell:B4:t:Purchase Price:b:1:1::1:f:1\ncell:C4:vtc:n$:250000:$250000:b:1:1:::f:1:ntvf:4\ncell:E4:t:\\n<div id=\"mortgage\" style=\"width\\c300px;height\\c200px;\"></div> \\n<!--script\\n\\n$(function () {\\n\\nvar rates = \"C17,D17,E17,F17,G17\"\\nvar pay1 = \"C18,D18,E18,F18,G18\"\\nvar pay2 = \"C20,D20,E20,F20,G20\"\\nvar pay3 = \"C22,D22,E22,F22,G22\"\\nvar pay4 = \"C23,D23,E23,F23,G23\"\\n\\n\\nvar valsrates = SocialCalc.GetCellDataArray(rates)\\nvar valspay1 = SocialCalc.GetCellDataArray(pay1)\\nvar valspay2 = SocialCalc.GetCellDataArray(pay2)\\nvar valspay3 = SocialCalc.GetCellDataArray(pay3)\\nvar valspay4 = SocialCalc.GetCellDataArray(pay4)\\n\\nvar datapay1 = []\\nvar datapay2 = []\\nvar datapay3 = []\\nvar datapay4 = []\\n\\nvar ticks = valsrates\\nvar index=0;\\nfor (index=0;index<ticks.length;index++) {\\n  datapay1.push([ticks[index],valspay1[index]])\\n  datapay2.push([ticks[index],valspay2[index]])\\n datapay3.push([ticks[index],valspay3[index]])\\n datapay4.push([ticks[index],valspay4[index]])\\n}\\n\\nfunction xtickformatter(val, axis){\\n  return (val*100).toFixed(axis.tickDecimals) + \"%\"\\n}\\n\\nfunction ytickformatter(val, axis){\\n  return \"$\"+val\\n}\\n\\nfunction showTooltip(contents) {\\n       var ele = document.getElementById(\"mortgage-tooltip\");\\n       ele.innerHTML = contents;\\n}\\n\\n//var previousPoint = null;\\n\\n    $(\"#mortgage\").bind(\"plothover\", function (event, pos, item) {\\n        $(\"#x\").text(pos.x.toFixed(2));\\n        $(\"#y\").text(pos.y.toFixed(2));\\n\\n            if (item) {\\n                    //if (previousPoint != item.dataIndex) {\\n                    //previousPoint = item.dataIndex;\\n                    //$(\"#mortgage-tooltip\").remove();\\n                    var x = (item.datapoint[0]*100).toFixed(2),\\n                        y = item.datapoint[1].toFixed(2);\\n                    \\n                    showTooltip(\"<small>\"+\"rate=\"+x+\"%<br>\"+\"downpayment=\"+item.series.label+\"<br>\"+\"monthly payment=\"+\"$\"+y+\"</small>\");\\n                    //}\\n                }\\n            }\\n        );\\n\\n\\n    $.plot($(\"#mortgage\"), [ \\n                      {data\\cdatapay1, hoverable\\ctrue,label\\c\"6%\"},\\n                      {data\\cdatapay2, hoverable\\ctrue,label\\c\"10%\"},\\n                      {data\\cdatapay3, hoverable\\ctrue,label\\c\"15%\"},\\n                      {data\\cdatapay4, hoverable\\ctrue,label\\c\"20%\"},\\n                  ], {\\n                  series\\c {stack\\c 0, lines\\c{show\\c true}, points\\c{show\\ctrue}},\\n                  xaxis\\c {ticks\\c ticks, tickDecimals\\c 2, tickFormatter\\c xtickformatter},\\n                  yaxis\\c {tickFormatter\\c ytickformatter},\\n                  grid\\c {hoverable\\c true},\\n                  legend\\c {show\\ctrue, noColumns\\c1,container\\c\"#mortgage-legend\"},\\n                  ticks\\c ticks\\n               });\\n\\n\\n});\\n\\n\\nscript-->:tvf:5:colspan:4:rowspan:11\ncell:I4:t:Down Payment\\n<br>\\n<br>\\n\\n<div id=\"mortgage-legend\" style=\"width\\c120px;height\\c100px;\"></div> \\n<br>\\n<div id=\"mortgage-tooltip\" style=\"width\\c120px;height\\c20px;\">\\n</div>:tvf:5:rowspan:11\ncell:B5:t:% down payment:b::1::1:f:1\ncell:C5:vtc:n%:0.15:15%:b::1:::f:1:ntvf:2\ncell:B6:t:Down payment:b::1::1:f:1\ncell:C6:vtf:n:37500:C4*C5:b::1:::f:1:ntvf:4\ncell:B7:t:Loan Amount:b::1::1:f:1\ncell:C7:vtf:n$:212500:C4-C6:b::1:::f:1:ntvf:4\ncell:B8:t:Interest Rate:b::1::1:f:1\ncell:C8:vtc:n%:0.05:5%:b::1:::f:1:ntvf:3\ncell:B9:t:Mortgage Term in years:b::1::1:f:1\ncell:C9:v:30:b::1:::f:1:ntvf:1\ncell:B10:t:Monthly Payment:b::1::1:f:1\ncell:C10:vtf:n$:1140.7459489007972:-1*PMT(C8/12,C9*12,C7):b::1:::f:1\ncell:B11:t:Tax Rate:b::1:1:1:f:1\ncell