33,D33,E33,F33\"\\nvar valsequity = SocialCalc.GetCellDataArray(equity,\"balance\")\\nvar valsshares = SocialCalc.GetCellDataArray(shares,\"income\")\\n\\nvar rawdates = SocialCalc.GetCellDataArray(dates,\"balance\")\\n\\nvar jdate = [];\\nvar years = [];\\nSocialCalc.UserScriptData.dates = null\\nvar min = 0;\\nif (SocialCalc.UserScriptData.dates == null) {\\n  for (var c in rawdates) {\\n    var d = rawdates[c]\\n    var comps = d.split(\"/\")\\n    console.log(comps)\\n    var jd = new Date(parseInt(comps[2]),parseInt(comps[0])-1,parseInt(comps[1]))\\n    years.push(comps[2]);\\n    var timestamp = jd.getTime()\\n    if (min==0) { min = timestamp;} else {\\n      if (min > timestamp) {min = timestamp;}\\n    } \\n    jdate.push(timestamp)\\n  }\\n  SocialCalc.UserScriptData.dates = jdate;\\n} else {\\n  jdate = SocialCalc.UserScriptData.dates\\n}\\n \\n\\nvar d1 = []\\nvar d2 = []\\nvar ticks = []\\nfor (var c in jdate) {\\n  d1.push([jdate[c],valsequity[c]/valsshares[c]])\\n  ticks.push([jdate[c],years[c]])\\n}\\n\\n    $.plot($(\"#equitypshare\"), [ {data\\cd1,label\\c\"equity\"}], {\\n                  series\\c {stack\\c null,\\n                    lines\\c{show\\ctrue}, \\n                    bars\\c{show\\cfalse}\\n                  },\\n                  xaxis\\c {ticks\\c ticks}\\n               });\\n\\n\\n});\\n\\n\\nscript-->\\n:tvf:1:colspan:5:rowspan:11\ncell:H5:t: <div id=\"operprofit\" style=\"width\\c350px;height\\c200px;\"></div> \\n<!--script\\n\\n$(function () {\\n\\nvar dates = \"B2,C2,D2,E2,F2\"\\nvar profit = \"B16,C16,D16,E16,F16\"\\nvar revenue = \"B4,C4,D4,E4,F4\"\\nvar shares = \"B33,C33,D33,E33,F33\"\\nvar valsprof = SocialCalc.GetCellDataArray(profit,\"income\")\\nvar valsrev = SocialCalc.GetCellDataArray(revenue,\"income\")\\nvar valsshares = SocialCalc.GetCellDataArray(shares,\"income\")\\n\\nvar rawdates = SocialCalc.GetCellDataArray(dates,\"balance\")\\n\\nvar jdate = [];\\nvar years = [];\\nSocialCalc.UserScriptData.dates = null\\nvar min = 0;\\nif (SocialCalc.UserScriptData.dates == null) {\\n  for (var c in rawdates) {\\n    var d = rawdates[c]\\n    var comps = d.split(\"/\")\\n    console.log(comps)\\n    var jd = new Date(parseInt(comps[2]),parseInt(comps[0])-1,parseInt(comps[1]))\\n    years.push(comps[2]);\\n    var timestamp = jd.getTime()\\n    if (min==0) { min = timestamp;} else {\\n      if (min > timestamp) {min = timestamp;}\\n    } \\n    jdate.push(timestamp)\\n  }\\n  SocialCalc.UserScriptData.dates = jdate;\\n} else {\\n  jdate = SocialCalc.UserScriptData.dates\\n}\\n \\n\\nvar d1 = []\\nvar d2 = []\\nvar ticks = []\\nfor (var c in jdate) {\\n  d1.push([jdate[c],valsprof[c]/valsshares[c]])\\n  d2.push([jdate[c],valsrev[c]/valsshares[c]])\\n  ticks.push([jdate[c],years[c]])\\n}\\n\\n    $.plot($(\"#operprofit\"), [ \\n                               {data\\cd2,label\\c\"revenue\"},\\n {data\\cd1,label\\c\"operating profit\"}], {\\n                  series\\c {stack\\c null,\\n                    lines\\c{show\\ctrue}, \\n                    bars\\c{show\\cfalse}\\n                  },\\n                  xaxis\\c {ticks\\c ticks}\\n               });\\n\\n\\n});\\n\\n\\nscript-->\\n:tvf:1:colspan:5:rowspan:11\ncell:B20:t:Returns:f:1:cf:1:colspan:5\ncell:H20:t:Margins:f:1:cf:1:colspan:5\ncell:B21:t: <div id=\"returns\" style=\"width\\c350px;height\\c200px;\"></div> \\n<!--script\\n\\n$(function () {\\n\\nvar dates = \"B2,C2,D2,E2,F2\"\\nvar roe = \"D23,E23,F23,G23,H23\"\\nvar roa = \"D22,E22,F22,G22,H22\"\\nvar valsroe = SocialCalc.GetCellDataArray(roe,\"dcf\")\\nvar valsroa = SocialCalc.GetCellDataArray(roa,\"dcf\")\\n\\nvar rawdates = SocialCalc.GetCellDataArray(dates,\"balance\")\\n\\nvar jdate = [];\\nvar years = [];\\nSocialCalc.UserScriptData.dates = null\\nvar min = 0;\\nif (SocialCalc.UserScriptData.dates == null) {\\n  for (var c in rawdates) {\\n    var d = rawdates[c]\\n    var comps = d.split(\"/\")\\n    console.log(comps)\\n    var jd = new Date(parseInt(comps[2]),parseInt(comps[0])-1,parseInt(comps[1]))\\n    years.push(comps[2]);\\n    var timestamp = jd.getTime()\\n    if (min==0) { min = timestamp;} else {\\n      if (min > timestamp) {min = timestamp;}\\n    } \\n    jdate.push(timestamp)\\n  }\\n  SocialCalc.UserScriptData.dates = jdate;\\n} else {\\n  jdate = SocialCalc.UserScriptData.dates\\n}\\n \\n\\nvar d1roe = []\\nvar d1roa = []\\nvar ticks = []\\nfor (var c in jdate) {\\n  d1roe.push([jdate[c],valsroe[c]])\\n  d1roa.push([jdate[c],valsroa[c]])\\n  ticks.push([jdate[c],years[c]])\\n}\\n\\n    $.plot($(\"#returns\"), [ {data\\cd1roe,label\\c\"ROE\"},\\n                                 {data\\cd1roa, label\\c\"ROA\"} ], {\\n                  series\\c {stack\\c 0},\\n                  xaxis\\c {ticks\\c ticks},\\n                  ticks\\c ticks\\n               });\\n\\n\\n});\\n\\n\\nscript-->:tvf:1:colspan:5:rowspan:11\ncell:H21:t: <div id=\"margins\" style=\"width\\c350px;height\\c200px;\"></div> \\n<!--script\\n\\n$(function () {\\n\\nvar dates = \"B2,C2,D2,E2,F2\"\\nvar gm = \"D16,E16,F16,G16,H16\"\\nvar om = \"D17,E17,F17,G17,H17\"\\nvar nm = \"D18,E18,F18,G18,H18\"\\nvar valsgm = SocialCalc.GetCellDataArray(gm,\"dcf\")\\nvar valsom = SocialCalc.GetCellDataArray(om,\"dcf\")\\nvar valsnm = SocialCalc.GetCellDataArray(nm,\"dcf\")\\n\\nvar rawdates = SocialCalc.GetCellDataArray(dates,\"balance\")\\n\\nvar jdate = [];\\nvar years = [];\\nSocialCalc.UserScriptData.dates = null\\nvar min = 0;\\nif (SocialCalc.UserScriptData.dates == null) {\\n  for (var c in rawdates) {\\n    var d = rawdates[c]\\n    var comps = d.split(\"/\")\\n    console.log(comps)\\n    var jd = new Date(parseInt(comps[2]),parseInt(comps[0])-1,parseInt(comps[1]))\\n    years.push(comps[2])\\n    var timestamp = jd.getTime()\\n    if (min==0) { min = timestamp;} else {\\n      if (min > timestamp) {min = timestamp;}\\n    } \\n    jdate.push(timestamp)\\n  }\\n  SocialCalc.UserScriptData.dates = jdate;\\n} else {\\n  jdate = SocialCalc.UserScriptData.dates\\n}\\n \\n\\nvar d1 = []\\nvar d2 = []\\nvar d3 = []\\nvar ticks = []\\n\\nfor (var c in jdate) {\\n  d1.push([jdate[c],valsgm[c]])\\n  d2.push([jdate[c],valsom[c]])\\n  d3.push([jdate[c],valsnm[c]])\\n  ticks.push([jdate[c],years[c]])\\n}\\n\\n    $.plot($(\"#margins\"), [ {data\\cd1,label\\c\"gross\"},\\n                                 {data\\cd2, label\\c\"operating\"},\\n                                 {data\\cd3, label\\c\"net\"} ], {\\n                  series\\c {stack\\c null,\\n                           lines\\c{show\\cfalse}, \\n                           bars\\c{show\\ctrue, barWidth\\c0.9}\\n                          },\\n                  xaxis\\c {ticks\\c ticks}\\n               });\\n\\n\\n});\\n\\n\\nscript-->\\n:tvf:1:colspan:5:rowspan:11\nsheet:c:8:r:21\ncellformat:1:center\ncellformat:2:left\nfont:1:normal bold * *\nfont:2:normal bold 14pt *\nvalueformat:1:text-html\n"},"name":"chart"},"sheet8":{"sheetstr":{"savestr":"version:1.5\ncell:B2:vtf:t:MSFT:UPPER(DATA!C3):f:3:colspan:2:rowspan:2\ncell:B5:t:<button id='comparetickersbutton' onclick='SocialCalc.CompareTickers();'>\\nCompare\\n</button>\\n<!--script\\nSocialCalc.CompareTickers = function() {\\n\\n  SocialCalc.SpinnerWaitCreate();\\n  var tick1 = SocialCalc.GetCellDataValue(\"compare!C6\");\\n  var tick2 = SocialCalc.GetCellDataValue(\"compare!D6\");\\n  var tick3 = SocialCalc.GetCellDataValue(\"compare!E6\");\\n  //alert(tick1+\",\"+tick2+\",\"+tick3);\\n\\n  if (tick1 == \"\") {\\n     tick1 = \"---\";\\n  } \\n  if (tick2 == \"\") {\\n     tick2 = \"---\";\\n  } \\n  if (tick3 == \"\") {\\n     tick3 = \"---\";\\n  } \\n  // send a query to the server\\n  var message = {};\\n  message.tick1 = tick1;\\n  message.tick2 = tick2;\\n  message.tick3 = tick3;\\n\\n  $.postJSON(\"/tickerjson\", message, function(response) {\\n     if (response[\"result\"] == \"fail\") {\\n        alert(\"Invalid ticker\");\\n        SocialCalc.SpinnerWaitHide();\\n        return;\\n     }\\n     SocialCalc.UserScriptData.HandleTickerJson(response);\\n  });\\n\\n\\n  SocialCalc.UserScriptData.HandleTickerJson = function(response) {\\n     var msg = response[\"data\"];\\n     data = JSON.parse(msg);\\n     SocialCalc.SpinnerWaitHide();\\n     var count = 1;\\n     if (SocialCalc.UserScriptData.TickerData == null) {\\n       SocialCalc.UserScriptData.TickerData = {}\\n     }\\n     SocialCalc.UserScriptData.TickerData[\"tick1\"] = data[\"tick1\"];\\n     var cmdstr = SocialCalc.UserScriptData.SetTickerData(\"tick1\", 10, SocialCalc.UserScriptData.GetRoe); \\n     SocialCalc.UserScriptData.TickerData[\"tick2\"] = data[\"tick2\"];\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick2\", 11, SocialCalc.UserScriptData.GetRoe);\\n     SocialCalc.UserScriptData.TickerData[\"tick3\"] = data[\"tick3\"];\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick3\", 12, SocialCalc.UserScriptData.GetRoe);\\n\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick1\", 19, SocialCalc.UserScriptData.GetRoa);\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick2\", 20, SocialCalc.UserScriptData.GetRoa);\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick3\", 21, SocialCalc.UserScriptData.GetRoa);\\n\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick1\", 28, SocialCalc.UserScriptData.GetNetMargin);\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick2\", 29, SocialCalc.UserScriptData.GetNetMargin);\\n     cmdstr += SocialCalc.UserScriptData.SetTickerData(\"tick3\", 30, SocialCalc.UserScriptData.GetNetMargin);\\n\\n     //alert(cmdstr);\\n \\n     var control = SocialCalc.GetCurrentWorkBookControl();\\n\\n     cmd = {cmdtype\\c\"scmd\", id\\c\"sheet8\", cmdstr\\c cmdstr, saveundo\\c false};\\n     control.ExecuteWorkBookControlCommand(cmd, false);  \\n\\n\\n  }  \\n\\n  SocialCalc.UserScriptData.GetRoe = function(tick, index) {\\n      var td = SocialCalc.UserScriptData.TickerData;\\n      var opinc = td[tick][\"Income\"][\"OperatingProfit\"][index].replace(\",\",\"\");\\n      var toteq = td[tick][\"Balance\"][\"TotalEquity\"][index].replace(\",\",\"\");\\n      return parseFloat(opinc)/parseFloat(toteq)\\n  }\\n\\nSocialCalc.UserScriptData.GetRoa = function(tick, index) {\\n      var td = SocialCalc.UserScriptData.TickerData;\\n      var opinc = td[tick][\"Income\"][\"OperatingProfit\"][index].replace(\",\",\"\");\\n      var assets = td[tick][\"Balance\"][\"Assets\"][index].replace(\",\",\"\");\\n      return parseFloat(opinc)/parseFloat(assets)\\n  }\\n\\n SocialCalc.UserScriptData.GetNetMargin = function(tick, index) {\\n      var td = SocialCalc.UserScriptData.TickerData;\\n      var netinc = td[tick][\"Income\"][\"NetIncome\"][index].replace(\",\",\"\");\\n      var rev = td[tick][\"Income\"][\"OperatingRevenue\"][index].replace(\",\",\"\");\\n      return parseFloat(netinc)/parseFloat(rev)\\n  }\\n\\n  SocialCalc.UserScriptData.SetTickerData = function(tick, eqrow, fn) {\\n     // just put some data into the cells\\n     var cmd = \"\"; \\n     var cmdstr = \"set C\"+eqrow+\" value n \"+ fn(tick, 0) +\"\\bn\"+\\n                  \"set D\"+eqrow+\" value n \"+ fn(tick, 1) +\"\\bn\"+\\n                  \"set E\"+eqrow+\" value n \"+ fn(tick, 2) +\"\\bn\"+\\n                  \"set F\"+eqrow+\" value n \"+ fn(tick, 3) +\"\\bn\"+\\n                  \"set G\"+eqrow+\" value n \"+ fn(tick, 4) +\"\\bn\";\\n     return cmdstr;\\n  }\\n\\n}\\nvar ele = document.getElementById('comparetickersbutton');\\nSocialCalc.TouchRegister(ele, {SingleTap\\cele.onclick});\\n\\nscript-->\\n:l:1:tvf:3:rowspan:2\ncell:C5:t:Ticker 1:f:2:cf:1\ncell:D5:t:Ticker 2:f:2:cf:1\ncell:E5:t:Ticker 3:f:2:cf:1\ncell:C6:t:goog:f:1:bg:1:cf:1\ncell:D6:t:adbe:f:1:bg:1:cf:1\ncell:E6:t:orcl:f:1:bg:1:cf:1\ncell:B8:t:ROE:f:2\ncell:H8:t:<div id=\"compare-roe\" style=\"width\\c250px;height\\c150px;\"></div> \\n<!--script\\n\\n$(function () {\\n\\nvar dates = \"B2,C2,D2,E2,F2\"\\nvar tick1 = \"C9,D9,E9